{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2024.String", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["main.ts", "backend-panel.ts", "env.d.ts", "../src/**/*.ts", "../spec/**/*.ts"]
}
