# Every text file is stored and checked out with LF, on every platform. Tests compare fixture bytes
# (canonical JSON, golden reports, signatures) byte for byte, and a CRLF checkout on Windows breaks them.
* text=auto eol=lf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.bin binary
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary

# Spec 0.6.1 (TD-103): files whose bytes are hashed, signed or compared byte for byte are stored and checked out
# exactly as committed, whatever core.autocrlf says: the shared vectors (SHA256SUMS, release manifests, artefacts)
# and the bundled release tool. A CRLF checkout of either would change a sha256 that a test or a signature pins.
spec/vectors/** -text
spec/tools/** -text
dist-release/** -text
